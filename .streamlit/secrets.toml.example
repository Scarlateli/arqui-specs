# secrets.toml.example — copie para .streamlit/secrets.toml e preencha
# O arquivo real (secrets.toml) NUNCA vai para o Git (.gitignore garante isso)
# No Streamlit Cloud: adicione os mesmos valores em Settings > Secrets

ANTHROPIC_API_KEY = "sk-ant-..."   # Sua chave da API Anthropic
APP_PASSWORD = "troque-esta-senha" # Senha de acesso ao app
